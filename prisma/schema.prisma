generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id_user           Int          @id @default(autoincrement())
  kode_user         String       @unique
  nama              String
  username          String       @unique
  password          String
  jkl               JenisKelamin
  foto              String?
  role              Role
  no_hp             String?
  email             String?      @unique
  status            Boolean      @default(true)
  theme_preference  String       @default("SYSTEM")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  baa               baa[]
  fabSales          fab[]        @relation("FabSales")
  fabPenginput      fab[]        @relation("FabPenginput")
  baaTeknisi        baateknisi[]

  @@map("users")
}

model area {
  id_area    Int      @id @default(autoincrement())
  kode_area  String   @unique(map: "Area_kode_area_key")
  nama_area  String
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fab        fab[]
  pop        pop[]

  @@map("area")
}

model baa {
  id_baa            Int          @id @default(autoincrement())
  kode_baa          String       @unique(map: "Baa_kode_baa_key")
  tanggal_instalasi DateTime
  status            baa_status   @default(SELESAI)
  catatan           String?
  foto_instalasi    String?
  id_fab            Int
  id_user           Int
  id_olt            Int
  id_ont            Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  id_odp            Int
  ping_ms           Decimal?
  port_odp          Int?
  port_olt          Int?
  rx_power_dbm      Decimal?
  speed_download    String?
  speed_upload      String?
  tx_power_dbm      Decimal?
  fab               fab          @relation(fields: [id_fab], references: [id_fab], map: "Baa_id_fab_fkey")
  odp               odp          @relation(fields: [id_odp], references: [id_odp], map: "Baa_id_odp_fkey")
  olt               olt          @relation(fields: [id_olt], references: [id_olt], map: "Baa_id_olt_fkey")
  ont               ont?         @relation(fields: [id_ont], references: [id_ont], map: "Baa_id_ont_fkey")
  users             User         @relation(fields: [id_user], references: [id_user], map: "Baa_id_user_fkey")
  baadetail         baadetail[]
  teknisiTambahan   baateknisi[]

  @@index([id_fab], map: "Baa_id_fab_fkey")
  @@index([id_odp], map: "Baa_id_odp_fkey")
  @@index([id_olt], map: "Baa_id_olt_fkey")
  @@index([id_ont], map: "Baa_id_ont_fkey")
  @@index([id_user], map: "Baa_id_user_fkey")

  @@map("baa")
}

model baadetail {
  id_baa_detail Int      @id @default(autoincrement())
  id_baa        Int
  id_material   Int
  jumlah        Int
  keterangan    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  baa           baa      @relation(fields: [id_baa], references: [id_baa], map: "BaaDetail_id_baa_fkey")
  material      material @relation(fields: [id_material], references: [id_material], map: "BaaDetail_id_material_fkey")

  @@index([id_baa], map: "BaaDetail_id_baa_fkey")
  @@index([id_material], map: "BaaDetail_id_material_fkey")

  @@map("baadetail")
}

model baateknisi {
  id_baa_teknisi Int      @id @default(autoincrement())
  id_baa         Int
  id_user        Int
  createdAt      DateTime @default(now())
  baa            baa      @relation(fields: [id_baa], references: [id_baa], map: "BaaTeknisi_id_baa_fkey")
  users          User     @relation(fields: [id_user], references: [id_user], map: "BaaTeknisi_id_user_fkey")

  @@unique([id_baa, id_user], map: "BaaTeknisi_id_baa_id_user_key")
  @@index([id_user], map: "BaaTeknisi_id_user_fkey")

  @@map("baa_teknisi")
}

model fab {
  id_fab         Int        @id @default(autoincrement())
  kode_fab       String     @unique(map: "Fab_kode_fab_key")
  nama_pelanggan String
  nik            String     @unique(map: "Fab_nik_key")
  foto           String?
  no_hp          String
  alamat         String
  latitude       Decimal
  longitude      Decimal
  status         fab_status @default(OPEN)
  id_area        Int
  id_paket       Int
  id_user        Int
  id_penginput   Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  baa            baa[]
  area           area       @relation(fields: [id_area], references: [id_area], map: "Fab_id_area_fkey")
  paket          paket      @relation(fields: [id_paket], references: [id_paket], map: "Fab_id_paket_fkey")
  users          User       @relation("FabSales", fields: [id_user], references: [id_user], map: "Fab_id_user_fkey")
  penginput      User       @relation("FabPenginput", fields: [id_penginput], references: [id_user], map: "Fab_id_penginput_fkey")

  @@index([id_area], map: "Fab_id_area_fkey")
  @@index([id_paket], map: "Fab_id_paket_fkey")
  @@index([id_user], map: "Fab_id_user_fkey")
  @@index([id_penginput], map: "Fab_id_penginput_fkey")

  @@map("fab")
}

model material {
  id_material   Int              @id @default(autoincrement())
  kode_material String           @unique(map: "Material_kode_material_key")
  nama_material String
  stok          Int              @default(0)
  minimal_stok  Int              @default(5)
  satuan        String
  harga         Decimal
  kondisi       material_kondisi @default(BAIK)
  keterangan    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  baadetail     baadetail[]

  @@map("material")
}

model olt {
  id_olt       Int       @id @default(autoincrement())
  kode_olt     String    @unique(map: "Olt_kode_olt_key")
  nama_olt     String
  lokasi       String
  latitude     Decimal
  longitude    Decimal
  id_pop       Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ip_olt       String?
  password_olt String?
  username_olt String?
  foto_olt     String?
  baa          baa[]
  odp          odp[]
  pop          pop       @relation(fields: [id_pop], references: [id_pop], map: "Olt_id_pop_fkey")
  portpon      portPon[]

  @@index([id_pop], map: "Olt_id_pop_fkey")

  @@map("olt")
}

model odp {
  id_odp      Int       @id @default(autoincrement())
  kode_odp    String    @unique(map: "Odp_kode_odp_key")
  nama_odp    String
  alamat      String
  latitude    Decimal
  longitude   Decimal
  jumlah_port Int?
  stok_port   Int?      @default(0)
  id_olt      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  baa         baa[]
  olt         olt       @relation(fields: [id_olt], references: [id_olt], map: "Odp_id_olt_fkey")
  ont         ont[]
  portpon     portPon[]

  @@index([id_olt], map: "Odp_id_olt_fkey")

  @@map("odp")
}

model ont {
  id_ont        Int        @id @default(autoincrement())
  serial_number String     @unique(map: "Ont_serial_number_key")
  pelanggan     String
  status        ont_status @default(TERSEDIA)
  id_pop        Int
  id_odp        Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  baa           baa[]
  odp           odp        @relation(fields: [id_odp], references: [id_odp], map: "Ont_id_odp_fkey")
  pop           pop        @relation(fields: [id_pop], references: [id_pop], map: "Ont_id_pop_fkey")

  @@index([id_odp], map: "Ont_id_odp_fkey")
  @@index([id_pop], map: "Ont_id_pop_fkey")

  @@map("ont")
}

model paket {
  id_paket   Int      @id @default(autoincrement())
  kode_paket String   @unique(map: "Paket_kode_paket_key")
  nama_paket String
  kecepatan  String
  harga      Decimal  @db.Decimal(12, 2)
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fab        fab[]

  @@map("paket")
}

model pop {
  id_pop    Int      @id @default(autoincrement())
  kode_pop  String   @unique(map: "Pop_kode_pop_key")
  nama_pop  String
  alamat    String
  latitude  Decimal
  longitude Decimal
  id_area   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  olt       olt[]
  ont       ont[]
  area      area     @relation(fields: [id_area], references: [id_area], map: "Pop_id_area_fkey")

  @@index([id_area], map: "Pop_id_area_fkey")

  @@map("pop")
}

model portPon {
  id_port    Int            @id @default(autoincrement())
  nomor_port Int
  tipe_kartu String
  status     portpon_status @default(TERSEDIA)
  id_olt     Int
  id_odp     Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  odp        odp?           @relation(fields: [id_odp], references: [id_odp], map: "PortPon_id_odp_fkey")
  olt        olt            @relation(fields: [id_olt], references: [id_olt], map: "PortPon_id_olt_fkey")

  @@unique([id_olt, nomor_port], map: "PortPon_id_olt_nomor_port_key")
  @@index([id_odp], map: "PortPon_id_odp_fkey")

  @@map("portpon")
}

enum Role {
  ADMIN
  LEADER
  SALES
  TEKNISI
  LOGISTIK
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum baa_status {
  SELESAI
}

enum ont_status {
  TERSEDIA
  TERPASANG
  RUSAK
}

enum portpon_status {
  TERSEDIA
  TERPASANG
  RUSAK
}

enum material_kondisi {
  BAIK
  RUSAK
}

enum fab_status {
  OPEN
  AKTIF
}

enum ActivityType {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_DEACTIVATED
  LOGIN
  FAB_CREATED
  FAB_UPDATED
  FAB_DELETED
  BAA_CREATED
  BAA_UPDATED
  BAA_DELETED
  AREA_CREATED
  AREA_UPDATED
  AREA_DELETED
  POP_CREATED
  POP_UPDATED
  POP_DELETED
  OLT_CREATED
  OLT_UPDATED
  OLT_DELETED
  ODP_CREATED
  ODP_UPDATED
  ODP_DELETED
  ONT_CREATED
  ONT_UPDATED
  ONT_DELETED
  PAKET_CREATED
  PAKET_UPDATED
  PAKET_DELETED
  MATERIAL_CREATED
  MATERIAL_UPDATED
  MATERIAL_DELETED
  SETTINGS_UPDATED
}

model ActivityLog {
  id_log      Int          @id @default(autoincrement())
  type        ActivityType
  description String
  id_user     Int?
  createdAt   DateTime     @default(now())

  @@map("activity_logs")
}

model Settings {
  id_setting Int      @id @default(autoincrement())
  key        String   @unique
  value      String   @db.Text
  updatedAt  DateTime @updatedAt

  @@map("settings")
}
